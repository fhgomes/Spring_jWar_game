# Base URL of the running jWar stack (see docker-compose.yml).
BASE_URL=http://localhost:8080

# Firebase Auth Emulator host. Optional — only required by the auth.spec.ts
# tests once the emulator setup lands. Format is `host:port`.
FIREBASE_EMULATOR_HOST=localhost:9099

# Firebase project id (matches the JSON service account or emulator).
FB_PROJECT_ID=jwar-local
