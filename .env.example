# jWar local development environment template.
# Copy this file to .env and edit the values that say REQUIRED.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit secrets.

# ---------------------------------------------------------------------------
# Postgres (consumed by the `postgres` service and by the `app` JDBC URL)
# ---------------------------------------------------------------------------
DB_NAME=jwar
DB_USERNAME=jwar
# REQUIRED: choose any strong local password; not used outside docker-compose.
DB_PASSWORD=changeme

# Host-side port mapping. Override if 5432 collides with another Postgres.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# App (consumed by the Spring Boot container)
# ---------------------------------------------------------------------------
APP_HOST_PORT=8080
APP_BASE_URL=http://localhost:8080

# Comma-separated CORS origins the API will accept.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------------
# Your Firebase project id (visible in the Firebase console).
FB_PROJECT_ID=your-firebase-project-id

# REQUIRED on host: place the service-account JSON at
#   ./secrets/firebase-service-account.json
# The compose stack mounts that file at /secrets/firebase-service-account.json
# inside the container. The path is fixed; do not move it.
# (See docs/docker.md for how to generate the file.)

# ---------------------------------------------------------------------------
# pgAdmin (only used with the `dev-tools` compose profile)
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin
PGADMIN_HOST_PORT=5050
